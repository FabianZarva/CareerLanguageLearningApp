  Minigame1Dialogue:
  - text: Ah, Doctor. You're here, good.
    characterSprite: {fileID: 21300000, guid: 4863ff63468c50245bb12afa76e5d669, type: 3}
  - text: Today is something more challenging.
    characterSprite: {fileID: 21300000, guid: c1c9aa2858c20ed4cbec0454bacb5dd1, type: 3}
  - text: We're comparing some terms.
    characterSprite: {fileID: 21300000, guid: 4863ff63468c50245bb12afa76e5d669, type: 3}
  - text: Let's get started.
    characterSprite: {fileID: 21300000, guid: 6b03b1b4080d97b418882d91e27f0bd6, type: 3}
  Minigame2Dialogue:
  - text: Hello, Doctor.
    characterSprite: {fileID: 21300000, guid: 4863ff63468c50245bb12afa76e5d669, type: 3}
  - text: Today we will be reviewing some terms.
    characterSprite: {fileID: 21300000, guid: 4863ff63468c50245bb12afa76e5d669, type: 3}
  - text: Just follow my instructions.
    characterSprite: {fileID: 21300000, guid: 6b03b1b4080d97b418882d91e27f0bd6, type: 3}
  - text: Let's begin.
    characterSprite: {fileID: 21300000, guid: 4863ff63468c50245bb12afa76e5d669, type: 3}
  Minigame3Dialogue:
  - text: Welcome, doctor.
    characterSprite: {fileID: 21300000, guid: 4863ff63468c50245bb12afa76e5d669, type: 3}
  - text: Time to get your bearings around the operating room.
    characterSprite: {fileID: 21300000, guid: 4863ff63468c50245bb12afa76e5d669, type: 3}
  - text: Lets begin.
    characterSprite: {fileID: 21300000, guid: 6b03b1b4080d97b418882d91e27f0bd6, type: 3}
