  Minigame1Dialogue:
  - text: Welcome back, Lawyer.
    characterSprite: {fileID: 21300000, guid: 93206608af672474eb4ddf8efa290973, type: 3}
  - text: Today we're gonna relate some terms for a change.
    characterSprite: {fileID: 21300000, guid: 96db264cfa1d1c84aafd26e9f1881420, type: 3}
  - text: This one might prove a bit more difficult.
    characterSprite: {fileID: 21300000, guid: f5843e61ae60a4e4e9151a874c8a93cc, type: 3}
  - text: But I'm sure you'll be just fine.
    characterSprite: {fileID: 21300000, guid: 93206608af672474eb4ddf8efa290973, type: 3}
  - text: Let's get started.
    characterSprite: {fileID: 21300000, guid: 96db264cfa1d1c84aafd26e9f1881420, type: 3}
  Minigame2Dialogue:
  - text: Hey there, Lawyer.
    characterSprite: {fileID: 21300000, guid: 96db264cfa1d1c84aafd26e9f1881420, type: 3}
  - text: Let's review some law terms.
    characterSprite: {fileID: 21300000, guid: 96db264cfa1d1c84aafd26e9f1881420, type: 3}
  - text: This shouldn't take too long.
    characterSprite: {fileID: 21300000, guid: 93206608af672474eb4ddf8efa290973, type: 3}
  - text: Let's begin!
    characterSprite: {fileID: 21300000, guid: 96db264cfa1d1c84aafd26e9f1881420, type: 3}
  Minigame3Dialogue:
  - text: hello there, Lawyer!.
    characterSprite: {fileID: 21300000, guid: 96db264cfa1d1c84aafd26e9f1881420, type: 3}
  - text: Time to get you aquainted with the courtroom.
    characterSprite: {fileID: 21300000, guid: 93206608af672474eb4ddf8efa290973, type: 3}
  - text: You''ll be spending quite some time here.
    characterSprite: {fileID: 21300000, guid: 96db264cfa1d1c84aafd26e9f1881420, type: 3}
  - text: So it's important to know your way around.
    characterSprite: {fileID: 21300000, guid: 96db264cfa1d1c84aafd26e9f1881420, type: 3}
  - text: Let's get started, eh?
    characterSprite: {fileID: 21300000, guid: 93206608af672474eb4ddf8efa290973, type: 3}
